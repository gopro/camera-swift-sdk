{"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Configure App Capabilities For Camera Wi-Fi","anchor":"Configure-App-Capabilities-For-Camera-Wi-Fi","type":"heading"},{"inlineContent":[{"type":"text","text":"If your app connects to the camera’s Wi-Fi network for preview or other camera-local HTTP traffic, configure both app capabilities and "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Enable the ","type":"text"},{"code":"Hotspot Configuration","type":"codeVoice"},{"text":" capability (","type":"text"},{"code":"com.apple.developer.networking.HotspotConfiguration","type":"codeVoice"},{"text":") so iOS allows your app to join the camera Wi-Fi network.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enable ","type":"text"},{"code":"Access Wi-Fi Information","type":"codeVoice"},{"text":" (","type":"text"},{"code":"com.apple.developer.networking.wifi-info","type":"codeVoice"},{"text":") if your app verifies the current associated SSID during camera Wi-Fi flows.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add ","type":"text"},{"code":"NSAllowsLocalNetworking","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"NSAppTransportSecurity","type":"codeVoice"},{"text":" in your app’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Without these settings, Wi-Fi join flows can fail or iOS can block local camera traffic after association, which can surface as preview start failures or command timeouts."}],"type":"paragraph"},{"syntax":"xml","code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsLocalNetworking<\/key>","    <true\/>","<\/dict>"],"type":"codeListing"},{"level":2,"text":"Import The Framework","anchor":"Imp