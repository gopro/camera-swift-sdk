{"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"GoProConnect"}],"title":"Discovery And Connection"},"abstract":[{"text":"Discovery and connection flows are centered on a shared ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/Connector","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Discovery Workflow","anchor":"Discovery-Workflow","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/StartScanningForDevicesUseCase","type":"reference"},{"type":"text","text":" to begin discovery, and use "},{"isActive":true,"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetScanningStateUseCase","type":"reference"},{"type":"text","text":" to observe whether scanning is idle, active, or in an error state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetCameraDevicesUseCase"},{"type":"text","text":" to observe the set of currently discovered "},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/CameraDevice","type":"reference","isActive":true},{"text":" values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you prefer, you can also observe the same shared discovery state directly from the connector’s"},{"type":"text","text":" "},{"code":"scanState","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"devices"},{"type":"text","text":" properties."}],"type":"paragraph"},{"type":"codeListing","code":["let connector = ConnectSdk.shared.connector()","let startScanning = StartScanningForDevicesUseCase(connector: connector)","let scanningState = GetScanningStateUseCase(connector: connector)","let cameraDevices = GetCameraDevicesUseCase(connector: connector)","","_ = startScanning","_ = scanningState","_ = cameraDevices"],"syntax":"swift"},{"anchor":"Connection-Workflow","text":"Connection Workflow","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Once you have a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/CameraDevice","isActive":true},{"type":"text","text":", connect through "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","isActive":true},{"type":"text","text":" and disconnect through "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DisconnectFromDeviceUseCase","isActive":true},{"type":"text","text":"."}]},{"inlineContent":[{"text":"Connection lifecycle updates are then exposed from the device itself, especially through ","type":"text"},{"code":"primaryConnectionStatus","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"connectionStatuses","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If a user explicitly removes a camera from your app’s reconnect history, call ","type":"text"},{"code":"forgetDevice(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"on the shared connector after disconnecting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you use camera Wi-Fi connection flows, your app must include the "},{"type":"codeVoice","code":"Hotspot Configuration"},{"type":"text","text":" capability ("},{"type":"codeVoice","code":"com.apple.developer.networking.HotspotConfiguration"},{"type":"text","text":"). If you also verify the currently associated SSID, enable "},{"type":"codeVoice","code":"Access Wi-Fi Information"},{"type":"text","text":" ("},{"type":"codeVoice","code":"com.apple.developer.networking.wifi-info"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Connection Types","anchor":"Connection-Types"},{"inlineContent":[{"text":"Connection requests can target one or more network types, such as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/NetworkType"},{"text":" BLE or Wi-Fi. This lets calling code express whether it wants a lightweight transport, a higher-bandwidth transport, or both.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For Wi-Fi-backed features such as live preview, make sure your app’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"type":"text","text":" with "},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"type":"text","text":" enabled so iOS allows traffic to the camera on the local network."}]},{"text":"Failure Handling","anchor":"Failure-Handling","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Scanning failures are modeled with ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanError","type":"reference","isActive":true},{"text":" via ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanState","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Connection lifecycle changes are represented with ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceConnectionStatus","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device commands return "},{"type":"reference","identifier