{"kind":"article","abstract":[{"type":"text","text":"Discovery and connection flows are centered on a shared "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/Connector","isActive":true},{"type":"text","text":" instance."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/Connector","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/StartDeviceScanSessionUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceScanSession","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetScanningStateUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetCameraDevicesUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DisconnectFromDeviceUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/Device","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanState","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceConnectionStatus"],"anchor":"Related-Documentation"}],"variants":[{"paths":["\/documentation\/goproconnect\/discoveryandconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"GoProConnect"}],"roleHeading":"Article","title":"Discovery And Connection","role":"article"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Discovery-Workflow","type":"heading","level":2,"text":"Discovery Workflow"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/StartDeviceScanSessionUseCase","isActive":true},{"type":"text","text":" to begin discovery, and use "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetScanningStateUseCase","isActive":true},{"type":"text","text":" to observe whether scanning is idle, active, or in an error state. Keep the returned "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceScanSession","isActive":true},{"type":"text","text":" for as long as the owning screen or workflow needs discovery, then call "},{"type":"codeVoice","code":"release()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetCameraDevicesUseCase","isActive":true},{"type":"text","text":" to observe the set of currently discovered "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/CameraDevice","isActive":true},{"type":"text","text":" values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you prefer, you can also observe the same shared discovery state directly from the connector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"scanState"},{"type":"text","text":" and "},{"type":"codeVoice","code":"devices"},{"type":"text","text":" properties."}]},{"type":"codeListing","syntax":"swift","code":["let connector = ConnectSdk.shared.connector()","","final class DiscoveryScreenModel {","    private let startScanning: StartDeviceScanSessionUseCase","    private let scanningState: GetScanningStateUseCase","    private let cameraDevices: GetCameraDevicesUseCase","    private var scanSession: DeviceScanSession?","","    init(connector: Connector) {","        startScanning = StartDeviceScanSessionUseCase(connector: connector)","        scanningState = GetScanningStateUseCase(connector: connector)","        cameraDevices = GetCameraDevicesUseCase(connector: connector)","    }","","    deinit {","        scanSession?.release()","    }","","    func startDiscovery() {","        guard scanSession == nil else { return }","        scanSession = startScanning.invoke()","    }","}","","let model = DiscoveryScreenModel(connector: connector)","model.startDiscovery()"]},{"type":"heading","level":2,"anchor":"Connection-Workflow","text":"Connection Workflow"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/CameraDevice","isActive":true},{"type":"text","text":", connect through "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","isActive":true},{"type":"text","text":" and disconnect through "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DisconnectFromDeviceUseCase","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Connection lifecycle updates are then exposed from the device itself, especially through ","type":"text"},{"code":"primaryConnectionStatus","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"connectionStatuses","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If a user explicitly removes a camera from your app’s reconnect history, call ","type":"text"},{"code":"forgetDevice(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"on the shared connector after disconnecting.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you use camera Wi-Fi connection flows, your app must include the ","type":"text"},{"code":"Hotspot Configuration","type":"codeVoice"},{"text":" capability (","type":"text"},{"code":"com.apple.developer.networking.HotspotConfiguration","type":"codeVoice"},{"text":"). If you also verify the currently associated SSID, enable ","type":"text"},{"code":"Access Wi-Fi Information","type":"codeVoice"},{"text":" (","type":"text"},{"code":"com.apple.developer.networking.wifi-info","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","level":2,"anchor":"Connection-Types","text":"Connection Types"},{"type":"paragraph","inlineContent":[{"text":"Connection requests can target one or more network types, such as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/NetworkType"},{"text":" BLE or Wi-Fi. This lets calling code express whether it wants a lightweight transport, a higher-bandwidth transport, or both.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For Wi-Fi-backed features such as live preview, make sure your app’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"NSAppTransportSecurity","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"NSAllowsLocalNetworking","type":"codeVoice"},{"text":" enabled so iOS allows traffic to the camera on the local network.","type":"text"}]},{"anchor":"Failure-Handling","text":"Failure Handling","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Scanning failures are modeled with ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanError","isActive":true,"type":"reference"},{"text":" via ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanState","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection lifecycle changes are represented with "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceConnectionStatus","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device commands return "},{"identifier":"doc:\/\/com.gopro.connect.