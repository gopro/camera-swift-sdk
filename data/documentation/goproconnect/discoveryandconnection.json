{"variants":[{"paths":["\/documentation\/goproconnect\/discoveryandconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"GoProConnect"}],"role":"article","title":"Discovery And Connection","roleHeading":"Article"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/Connector","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/StartDeviceScanSessionUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceScanSession","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetScanningStateUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetCameraDevicesUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DisconnectFromDeviceUseCase","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/Device","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanState","doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceConnectionStatus"]}],"identifier":{"url":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DiscoveryAndConnection","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"anchor":"Discovery-Workflow","text":"Discovery Workflow","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/StartDeviceScanSessionUseCase"},{"text":" to begin discovery, and use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/GetScanningStateUseCase"},{"text":" to observe whether scanning is idle, active, or in