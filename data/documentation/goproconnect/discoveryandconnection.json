nnector)","model.startDiscovery()"],"syntax":"swift"},{"type":"heading","level":2,"text":"Connection Workflow","anchor":"Connection-Workflow"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/CameraDevice","isActive":true},{"type":"text","text":", connect through "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","isActive":true},{"type":"text","text":" and disconnect through "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DisconnectFromDeviceUseCase","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection lifecycle updates are then exposed from the device itself, especially through "},{"type":"codeVoice","code":"primaryConnectionStatus"},{"type":"text","text":" and "},{"type":"codeVoice","code":"connectionStatuses"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"If a user explicitly removes a camera from your app’s reconnect history, call ","type":"text"},{"code":"forgetDevice(_:)","type":"codeVoice"},{"type":"text","text":" "},{"text":"on the shared connector after disconnecting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you use camera Wi-Fi connection flows, your app must include the "},{"code":"Hotspot Configuration","type":"codeVoice"},{"type":"text","text":" capability ("},{"type":"codeVoice","code":"com.apple.developer.networking.HotspotConfiguration"},{"text":"). If you also verify the currently associated SSID, enable ","type":"text"},{"code":"Access Wi-Fi Information","type":"codeVoice"},{"text":" (","type":"text"},{"code":"com.apple.developer.networking.wifi-info","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Connection Types","level":2,"anchor":"Connection-Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection requests can target one or more network types, such as "},{"type":"reference","identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/NetworkType","isActive":true},{"type":"text","text":" BLE or Wi-Fi. This lets calling code express whether it wants a lightweight transport, a higher-bandwidth transport, or both."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For Wi-Fi-backed features such as live preview, make sure your app’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"type":"text","text":" with "},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"text":" enabled so iOS allows traffic to the camera on the local network.","type":"text"}]},{"type":"heading","text":"Failure Handling","level":2,"anchor":"Failure-Handling"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Scanning failures are modeled with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanError","type":"reference"},{"type":"text","text":" via "},{"isActive":true,"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanState","type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection lifecycle changes are represented with "},{"isActive":true,"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceConnectionStatus","type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device commands return "},{"isActive":true,"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceCommandResult","type":"reference"},{"text":" when the operation itself succeeds or fails.","type":"text"}]}]}],"