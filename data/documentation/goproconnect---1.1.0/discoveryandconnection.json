:"text","text":"If you prefer, you can also observe the same shared discovery state directly from the connector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"scanState"},{"type":"text","text":" and "},{"type":"codeVoice","code":"devices"},{"type":"text","text":" properties."}]},{"code":["let connector = ConnectSdk.shared.connector()","","final class DiscoveryScreenModel {","    private let startScanning: StartDeviceScanSessionUseCase","    private let scanningState: GetScanningStateUseCase","    private let cameraDevices: GetCameraDevicesUseCase","    private var scanSession: DeviceScanSession?","","    init(connector: Connector) {","        startScanning = StartDeviceScanSessionUseCase(connector: connector)","        scanningState = GetScanningStateUseCase(connector: connector)","        cameraDevices = GetCameraDevicesUseCase(connector: connector)","    }","","    deinit {","        scanSession?.release()","    }","","    func startDiscovery() {","        guard scanSession == nil else { return }","        scanSession = startScanning.invoke()","    }","}","","let model = DiscoveryScreenModel(connector: connector)","model.startDiscovery()"],"syntax":"swift","type":"codeListing"},{"anchor":"Connection-Workflow","level":2,"text":"Connection Workflow","type":"heading"},{"inlineContent":[{"type":"text","text":"Once you have a "},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/CameraDevice","type":"reference","isActive":true},{"text":", connect through ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","type":"reference","isActive":true},{"text":" and disconnect through ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DisconnectFromDeviceUseCase","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Connection lifecycle updates are then exposed from the device itself, especially through ","type":"text"},{"type":"codeVoice","code":"primaryConnectionStatus"},{"type":"text","text":" and "},{"type":"codeVoice","code":"connectionStatuses"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"If a user explicitly removes a camera from your app’s reconnect history, call ","type":"text"},{"code":"forgetDevice(_:)","type":"codeVoice"},{"type":"text","text":" "},{"text":"on the shared connector after disconnecting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you use camera Wi-Fi connection flows, your app must include the "},{"type":"codeVoice","code":"Hotspot Configuration"},{"type":"text","text":" capability ("},{"type":"codeVoice","code":"com.apple.developer.networking.HotspotConfiguration"},{"type":"text","text":"). If you also verify the currently associated SSID, enable "},{"type":"codeVoice","code":"Access Wi-Fi Information"},{"type":"text","text":" ("},{"type":"codeVoice","code":"com.apple.developer.networking.wifi-info"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Connection Types","anchor":"Connection-Types","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Connection requests can target one or more network types, such as "},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/NetworkType","type":"reference","isActive":true},{"text":" BLE or Wi-Fi. This lets calling code express whether it wants a lightweight transport, a higher-bandwidth transport, or both.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For Wi-Fi-backed features such as live preview, make sure your app’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"NSAppTransportSecurity"},{"type":"text","text":" with "},{"type":"codeVoice","code":"NSAllowsLocalNetworking"},{"type":"text","text":" enabled so iOS allows traffic to the camera on the local network."}],"type":"paragraph"},{"text":"Failure Handling","anchor":"Failure-Handling","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"text":"Scanning failures are modeled with ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanError","isActive":true,"type":"reference"},{"text":" via ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ScanState","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Connection lifecycle changes are represented with ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceConnectionStatus","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Device commands return ","type":"text"},{"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/DeviceCommandResult","isActive":true,"type":"reference"},{"text":" when the operation itself succeeds or fails.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://com.gopro.connect.docs.ios/documentation/GoProConnect/ConnectToDeviceUseCase":{"title":"ConnectToDeviceUseCase","abstract":[],"identifier":"doc:\/\/com.gopro.connect.docs.ios\/documentation\/GoProConnect\/ConnectToDeviceUseCase","role":"symbol","type":"topic","url":"\/documentation\/goproconnect\/connecttodeviceusecase","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConnectToDeviceUseCase","kind":"identifier"}],"navigatorTitle":[{"text":"ConnectToDeviceUseCase","kind":"identifier"}]},"doc://com.gopro.connect.docs.ios/documentation/GoProConnect/DisconnectFromDeviceUseCase":{"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DisconnectFromDeviceUseCase"}],"role":"symbol"